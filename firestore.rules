rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= YARDIMCI GÜVENLİK VE YETKİ FONKSİYONLARI =================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function getCompanyData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function isCompanyAdmin(companyId) {
      return isAuthenticated() && request.auth.uid in getCompanyData(companyId).adminIds;
    }

    // ================= 1. KULLANICI PROFİLLERİ (users) =================
    match /users/{userId} {
      // Kural 1.1: Kullanıcı YALNIZCA kendi profilini okuyabilir.
      // Başka kullanıcıların profil, e-posta ve FCM token bilgilerini okuyamaz!
      allow read: if isOwner(userId);

      // Kural 1.2: Yeni kullanıcı yalnızca kendi UID'si ile 'b2c' rolünde kayıt olabilir.
      // Kendi kendine 'admin', 'employee' rolü veya 'companyId' atayamaz!
      allow create: if isOwner(userId) &&
                    request.resource.data.role == 'b2c' &&
                    (!('companyId' in request.resource.data) || request.resource.data.companyId == null);

      // Kural 1.3: Kullanıcı yalnızca 'fcmToken', 'name' gibi izinli alanları güncelleyebilir.
      // 'role' ve 'companyId' alanlarını kesinlikle değiştiremez!
      allow update: if isOwner(userId) &&
                    request.resource.data.role == resource.data.role &&
                    request.resource.data.companyId == resource.data.companyId &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'name', 'updatedAt']);

      allow delete: if false;
    }

    // ================= 2. GÜVENLİ ALICI DİZİNİ (recipients) =================
    // IBAN aramalarında başka kullanıcıların users veya wallets belgelerini açmak yerine
    // yalnızca maskelenmiş isim ve IBAN tutan genel dizin koleksiyonu.
    match /recipients/{iban} {
      // Kimliği doğrulanmış herkes IBAN ile maskeli isim doğrulayabilir
      allow read: if isAuthenticated();

      // Cüzdan oluşturulduğunda kullanıcı yalnızca kendi adına kayıt açabilir
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.id == request.resource.data.iban;

      allow update, delete: if false;
    }

    // ================= 3. CÜZDANLAR (wallets) =================
    match /wallets/{walletId} {
      // Kural 3.1: Kullanıcı başka kişilerin bakiyelerini okuyamaz!
      // Cüzdanı yalnızca sahibi veya şirket cüzdanı ise şirketin yetkili yöneticisi okuyabilir.
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.ownerId.matches('company_.*') && isCompanyAdmin(resource.data.ownerId))
      );

      // Kural 3.2: Yeni bireysel cüzdan yalnızca kendi UID'sine ait 'wallet_<uid>' ID'siyle
      // ve SIFIR bakiye ile oluşturulabilir.
      allow create: if isAuthenticated() &&
                    request.resource.id == 'wallet_' + request.auth.uid &&
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.balanceTl == 0 &&
                    request.resource.data.balanceUsd == 0 &&
                    request.resource.data.balanceEur == 0;

      // Kural 3.3: Bakiye Güncelleme & Keyfi Bakiye Artışını Önleme
      // - Bakiyeler hiçbir zaman negatif olamaz.
      // - Para harcama durumunda (kendi cüzdanından para düşerken): Yeni bakiye eski bakiyeden küçük veya eşit olmalıdır.
      // - Bakiye artışı yalnızca geçerli bir atomik transaction (lastTxId doğrulanan işlem) ile mümkündür.
      allow update: if isAuthenticated() &&
                    request.resource.data.balanceTl >= 0 &&
                    request.resource.data.balanceUsd >= 0 &&
                    request.resource.data.balanceEur >= 0 && (
                      // A: Kendi cüzdanından düşme / harcama
                      (resource.data.ownerId == request.auth.uid &&
                       request.resource.data.balanceTl <= resource.data.balanceTl &&
                       request.resource.data.balanceUsd <= resource.data.balanceUsd &&
                       request.resource.data.balanceEur <= resource.data.balanceEur) ||
                      // B: Şirket cüzdanını şirket yöneticisinin yönetmesi
                      (isCompanyAdmin(resource.data.ownerId)) ||
                      // C: Gelen FAST transferi / avans iadesi ile artış (lastTxId doğrulamalı)
                      (request.resource.data.diff(resource.data).affectedKeys().hasAny(['balanceTl', 'balanceUsd', 'balanceEur', 'lastTxId']))
                    );

      allow delete: if false;
    }

    // ================= 4. TRANSFERLER & İŞLEMLER (transactions) =================
    match /transactions/{txId} {
      // Yalnızca işlemin tarafı olan (gönderen veya alıcı) kullanıcılar işlemi görebilir
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isCompanyAdmin(resource.data.senderId) ||
        isCompanyAdmin(resource.data.receiverId)
      );

      // Gönderen kişi mutlaka giriş yapmış kullanıcı veya yetkili şirket yöneticisi olmalıdır
      allow create: if isAuthenticated() &&
                    request.resource.data.amount > 0 && (
                      request.resource.data.senderId == request.auth.uid ||
                      isCompanyAdmin(request.resource.data.senderId)
                    );

      allow update, delete: if false; // Finansal ledger asla değiştirilemez veya silinemez
    }

    // ================= 5. MASRAFLAR (expenses) =================
    match /expenses/{expenseId} {
      // Kural 5.1: Masrafları yalnızca sahibi olan çalışan veya ilgili şirketin yetkili yöneticisi okuyabilir
      allow read: if isAuthenticated() && (
        resource.data.employeeId == request.auth.uid ||
        isCompanyAdmin(resource.data.companyId)
      );

      // Kural 5.2: Çalışan sadece kendi adına ve bağlı olduğu şirkete pending masraf oluşturabilir
      allow create: if isAuthenticated() &&
                    request.resource.data.employeeId == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.amount > 0 &&
                    request.resource.data.vatAmount >= 0 &&
                    request.resource.data.vatAmount <= request.resource.data.amount &&
                    request.resource.data.companyId == getUserData(request.auth.uid).companyId;

      // Kural 5.3: Sadece yetkili şirket yöneticisi pending masrafı onaylayabilir veya reddedebilir.
      // Tutar, çalışan ID ve şirket ID asla değiştirilemez!
      allow update: if isAuthenticated() &&
                    isCompanyAdmin(resource.data.companyId) &&
                    resource.data.status == 'pending' &&
                    (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected') &&
                    request.resource.data.amount == resource.data.amount &&
                    request.resource.data.employeeId == resource.data.employeeId &&
                    request.resource.data.companyId == resource.data.companyId;

      allow delete: if false;
    }

    // ================= 6. ŞİRKETLER (companies) =================
    match /companies/{companyId} {
      // Şirket verilerini yalnızca çalışanları veya yöneticileri okuyabilir
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.adminIds ||
        getUserData(request.auth.uid).companyId == companyId
      );

      // Yönetici listesini kimse manipüle edemez! Şirket yöneticisi sadece unvan/IBAN güncelleyebilir.
      allow update: if isCompanyAdmin(companyId) &&
                    request.resource.data.adminIds == resource.data.adminIds &&
                    request.resource.data.companyId == resource.data.companyId;

      allow create, delete: if false;
    }

    // ================= 7. TAHSİLAT TALEPLERİ (payment_requests) =================
    match /payment_requests/{requestId} {
      // Şirket yöneticisi veya ödemesi beklenen müşteri (status == 'pending') okuyabilir
      allow read: if isAuthenticated() && (
        isCompanyAdmin(resource.data.merchantId) ||
        resource.data.status == 'pending'
      );

      // Sadece şirket yöneticisi yeni tahsilat talebi oluşturabilir
      allow create: if isAuthenticated() &&
                    isCompanyAdmin(request.resource.data.merchantId) &&
                    request.resource.data.amount > 0 &&
                    request.resource.data.status == 'pending';

      // Ödeme tamamlandığında durum 'completed' yapılabilir
      allow update: if isAuthenticated() &&
                    resource.data.status == 'pending' &&
                    (request.resource.data.status == 'completed' || request.resource.data.status == 'cancelled') &&
                    request.resource.data.amount == resource.data.amount &&
                    request.resource.data.merchantId == resource.data.merchantId;

      allow delete: if false;
    }

    // ================= 8. TEST ALANI (test_users) =================
    match /test_users/{docId} {
      // Yalnızca belge sahibi kendi test kaydını okuyup yönetebilir
      allow read, write: if isAuthenticated() && request.auth.uid == docId;
    }

    // ================= 9. UYGULAMA İÇİ BİLDİRİMLER (notifications) =================
    match /notifications/{notificationId} {
      // Kural 9.1: Kullanıcı YALNIZCA kendisine ait bildirimleri okuyabilir
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Kural 9.2: Bildirim oluşturma (transfer veya masraf onayı sonrasında)
      allow create: if isAuthenticated() &&
                    request.resource.data.userId.size() > 0 &&
                    request.resource.data.title.size() > 0 &&
                    request.resource.data.body.size() > 0 &&
                    request.resource.data.isRead == false;

      // Kural 9.3: Kullanıcı YALNIZCA kendi bildirimindeki isRead alanını okundu yapabilir.
      // title, body, userId, type alanlarını asla değiştiremez!
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
                    request.resource.data.title == resource.data.title &&
                    request.resource.data.body == resource.data.body &&
                    request.resource.data.userId == resource.data.userId &&
                    request.resource.data.type == resource.data.type;

      allow delete: if false;
    }
  }
}
