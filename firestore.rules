rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function owner(uid) { return signed() && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function companyPath(id) { return /databases/$(database)/documents/companies/$(id); }
    function walletPath(id) { return /databases/$(database)/documents/wallets/$('wallet_' + id); }
    function txPath(id) { return /databases/$(database)/documents/transactions/$(id); }
    function expensePath(id) { return /databases/$(database)/documents/expenses/$(id); }
    function paymentPath(id) { return /databases/$(database)/documents/payment_requests/$(id); }
    function admin(id) {
      return signed() && id is string && exists(companyPath(id))
        && request.auth.uid in get(companyPath(id)).data.adminIds;
    }
    function member(id) {
      return signed() && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('companyId', null) == id;
    }
    function currency(c) { return c in ['TRY', 'USD', 'EUR']; }
    function balances(w) {
      return w.balanceTl is int && w.balanceTl >= 0
        && w.balanceUsd is int && w.balanceUsd >= 0
        && w.balanceEur is int && w.balanceEur >= 0;
    }
    function delta(a, b, c, n) {
      return balances(a) && balances(b)
        && b.balanceTl == a.balanceTl + (c == 'TRY' ? n : 0)
        && b.balanceUsd == a.balanceUsd + (c == 'USD' ? n : 0)
        && b.balanceEur == a.balanceEur + (c == 'EUR' ? n : 0);
    }
    function walletChange(id, tx, n) {
      let before = get(walletPath(id)).data;
      let after = getAfter(walletPath(id)).data;
      return before.ownerId == id && after.ownerId == id
        && before.walletId == 'wallet_' + id && after.walletId == before.walletId
        && after.diff(before).affectedKeys().hasOnly([
          'balanceTl','balanceUsd','balanceEur','lastTxId','updatedAt'
        ])
        && after.lastTxId == tx.txId && after.updatedAt == request.time
        && delta(before, after, tx.currency, n);
    }
    function expenseLink(tx) {
      let e = get(expensePath(tx.relatedId)).data;
      let a = getAfter(expensePath(tx.relatedId)).data;
      return e.status == 'pending' && a.status == 'approved'
        && a.approvedBy == request.auth.uid && a.approvedAt == request.time
        && a.txId == tx.txId && e.companyId == tx.senderId
        && e.employeeId == tx.receiverId && e.amount == tx.amount
        && tx.currency == 'TRY';
    }
    function paymentLink(tx) {
      let p = get(paymentPath(tx.relatedId)).data;
      let a = getAfter(paymentPath(tx.relatedId)).data;
      return p.status == 'pending' && a.status == 'completed'
        && a.payerId == tx.senderId && a.txId == tx.txId
        && a.completedAt == request.time && p.merchantId == tx.receiverId
        && p.amount == tx.amount && p.currency == tx.currency
        && (p.get('payerId', null) == null || p.payerId == tx.senderId);
    }
    function validTx(tx, id) {
      return signed() && tx.txId == id && tx.senderId is string
        && tx.receiverId is string && tx.senderId != tx.receiverId
        && tx.amount is int && tx.amount > 0 && currency(tx.currency)
        && tx.timestamp is string && tx.status == 'Başarılı'
        && (
          (tx.type == 'fast' && owner(tx.senderId))
          || (tx.type == 'qr_pos_payment' && owner(tx.senderId)
              && exists(companyPath(tx.receiverId)))
          || (tx.type == 'expense_reimbursement' && admin(tx.senderId)
              && tx.relatedId is string && expenseLink(tx))
          || (tx.type == 'payment_link' && owner(tx.senderId)
              && tx.relatedId is string && paymentLink(tx))
        )
        && walletChange(tx.senderId, tx, -tx.amount)
        && walletChange(tx.receiverId, tx, tx.amount);
    }
    function walletUpdate(walletId) {
      let id = request.resource.data.lastTxId;
      let tx = getAfter(txPath(id)).data;
      return id is string && !exists(txPath(id))
        && (walletId == 'wallet_' + tx.senderId || walletId == 'wallet_' + tx.receiverId)
        && validTx(tx, id);
    }
    function linkedExpenseUpdate(id) {
      let tx = getAfter(txPath(request.resource.data.txId)).data;
      return !exists(txPath(request.resource.data.txId))
        && tx.type == 'expense_reimbursement' && tx.relatedId == id
        && tx.senderId == resource.data.companyId
        && tx.receiverId == resource.data.employeeId
        && tx.amount == resource.data.amount && validTx(tx, tx.txId);
    }
    function linkedPaymentUpdate(id) {
      let tx = getAfter(txPath(request.resource.data.txId)).data;
      return !exists(txPath(request.resource.data.txId))
        && tx.type == 'payment_link' && tx.relatedId == id
        && tx.senderId == request.auth.uid && tx.receiverId == resource.data.merchantId
        && tx.amount == resource.data.amount && validTx(tx, tx.txId);
    }
    function notificationTx(n, id) {
      let tx = get(txPath(n.relatedId)).data;
      return tx.type == 'fast' && owner(tx.senderId) && (
        (n.type == 'transfer_received' && n.userId == tx.receiverId
          && id == 'notif_tx_' + n.relatedId
          && n.title == 'Para Transferi Alındı' && n.body == 'Yeni FAST transferiniz var. İşlem geçmişini kontrol edin.')
        || (n.type == 'fraud_alert' && n.userId == tx.senderId
          && tx.currency == 'TRY' && tx.amount >= 5000000
          && id == 'notif_fraud_' + n.relatedId
          && n.title == 'Yüksek Tutarlı Transfer Onayı' && n.body == 'Yüksek tutarlı FAST işleminizi kontrol edin.')
      );
    }
    function notificationExpense(n, id) {
      let e = get(expensePath(n.relatedId)).data;
      return (
        n.type == 'expense_created' && owner(e.employeeId)
          && exists(companyPath(e.companyId))
          && n.userId in get(companyPath(e.companyId)).data.adminIds
          && id == 'notif_exp_created_' + n.relatedId + '_' + n.userId
          && n.title == 'Yeni Masraf Onay Talebi' && n.body == 'Yeni bir masraf talebi var. Masraf ekranını kontrol edin.'
      ) || (
        n.type == 'expense_approved' && admin(e.companyId) && e.status == 'approved'
          && e.approvedBy == request.auth.uid && n.userId == e.employeeId
          && id == 'notif_exp_app_' + n.relatedId
          && n.title == 'Masrafınız Onaylandı' && n.body == 'Masraf talebiniz onaylandı. Masraf ekranını kontrol edin.'
      ) || (
        n.type == 'expense_rejected' && admin(e.companyId) && e.status == 'rejected'
          && e.rejectedBy == request.auth.uid && n.userId == e.employeeId
          && id == 'notif_exp_rej_' + n.relatedId
          && n.title == 'Masraf Talebiniz Reddedildi' && n.body == 'Masraf talebiniz reddedildi. Masraf ekranını kontrol edin.'
      );
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.uid == uid
        && request.resource.data.role == 'b2c'
        && request.resource.data.get('companyId', null) == null
        && request.resource.data.get('hasB2BAccess', false) == false;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','fcmToken','updatedAt'])
        && request.resource.data.get('fcmToken','') is string;
    }
    match /wallets/{id} {
      allow get: if signed() && (id == 'wallet_' + request.auth.uid || (resource != null && admin(resource.data.ownerId)));
      allow list: if signed() && (resource.data.ownerId == request.auth.uid || admin(resource.data.ownerId));
      allow create: if signed() && id == 'wallet_' + request.auth.uid
        && request.resource.data.walletId == id && request.resource.data.ownerId == request.auth.uid
        && balances(request.resource.data) && request.resource.data.balanceTl == 0
        && request.resource.data.balanceUsd == 0 && request.resource.data.balanceEur == 0
        && request.resource.data.iban is string && request.resource.data.iban.matches('TR[0-9]{24}');
      allow update: if signed() && walletUpdate(id);
    }
    match /recipients/{iban} {
      allow get: if signed();
      allow create: if signed() && request.resource.data.keys().hasOnly(['userId','maskedName','iban','createdAt'])
        && request.resource.data.userId == request.auth.uid && request.resource.data.maskedName is string
        && request.resource.data.iban == iban && iban.matches('TR[0-9]{24}')
        && request.resource.data.get('createdAt', request.time) == request.time
        && getAfter(walletPath(request.auth.uid)).data.iban == iban;
    }
    match /companies/{id} {
      allow read: if admin(id) || member(id);
    }
    match /transactions/{id} {
      allow read: if signed() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid
        || admin(resource.data.senderId) || admin(resource.data.receiverId));
      allow create: if validTx(request.resource.data, id);
    }
    match /expenses/{id} {
      allow read: if signed() && (resource.data.employeeId == request.auth.uid || admin(resource.data.companyId));
      allow create: if signed() && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'employee'
        && request.resource.data.expenseId == id && request.resource.data.employeeId == request.auth.uid
        && request.resource.data.companyId is string && member(request.resource.data.companyId)
        && request.resource.data.status == 'pending' && request.resource.data.amount is int
        && request.resource.data.amount > 0 && request.resource.data.vatAmount is int
        && request.resource.data.vatAmount >= 0 && request.resource.data.vatAmount <= request.resource.data.amount
        && request.resource.data.keys().hasOnly(['expenseId','employeeId','employeeName','merchantTitle','category','companyId','amount','vatAmount','receiptImageUrl','status','date','accountingCode']);
      allow update: if admin(resource.data.companyId) && resource.data.status == 'pending' && (
        (request.resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedAt','approvedBy','accountingCode','txId'])
          && request.resource.data.approvedBy == request.auth.uid && request.resource.data.approvedAt == request.time
          && request.resource.data.txId is string && linkedExpenseUpdate(id))
        || (request.resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','rejectReason','rejectedAt','rejectedBy'])
          && request.resource.data.rejectedBy == request.auth.uid && request.resource.data.rejectedAt == request.time
          && request.resource.data.rejectReason is string && request.resource.data.rejectReason.size() > 0)
      );
    }
    match /payment_requests/{id} {
      allow get: if signed() && (admin(resource.data.merchantId) || resource.data.get('payerId',null) == request.auth.uid
        || (resource.data.status == 'pending' && resource.data.get('payerId',null) == null));
      allow list: if signed() && (admin(resource.data.merchantId) || resource.data.get('payerId',null) == request.auth.uid);
      allow create: if admin(request.resource.data.merchantId) && request.resource.data.requestId == id
        && request.resource.data.status == 'pending' && request.resource.data.amount is int
        && request.resource.data.amount > 0 && currency(request.resource.data.currency);
      allow update: if signed() && resource.data.status == 'pending' && (
        (request.resource.data.status == 'completed' && request.resource.data.payerId == request.auth.uid
          && request.resource.data.completedAt == request.time && request.resource.data.txId is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','payerId','completedAt','txId'])
          && linkedPaymentUpdate(id))
        || (admin(resource.data.merchantId) && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt']))
      );
    }
    match /notifications/{id} {
      allow read: if signed() && resource.data.userId == request.auth.uid;
      allow create: if signed() && request.resource.data.notificationId == id
        && request.resource.data.isRead == false && request.resource.data.relatedId is string
        && request.resource.data.keys().hasOnly(['notificationId','userId','title','body','type','createdAt','relatedId','isRead'])
        && ((request.resource.data.type in ['transfer_received','fraud_alert'] && notificationTx(request.resource.data,id))
          || (request.resource.data.type in ['expense_created','expense_approved','expense_rejected'] && notificationExpense(request.resource.data,id)));
      allow update: if signed() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && request.resource.data.isRead == true;
    }
    match /test_users/{uid} { allow read, write: if owner(uid); }
    match /{document=**} { allow read, write: if false; }
  }
}
